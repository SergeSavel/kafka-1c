Функция ConsumerGetMessagesНаСервере(Кластер, АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Тема, СтарыеИлиНовые, КоличествоНаРаздел)
	
	Адаптер = Адаптер(АдаптерПараметры);
	
	ДопКонфигурация = Новый Соответствие;
	ДопКонфигурация.Вставить("auto.offset.reset", "earliest");
	ДопКонфигурация.Вставить("enable.auto.commit", "false");
		
	Consumer = КафкаСервер.СоздатьConsumer(
			Кластер,
			Адаптер,
			"Обработка КафкаАдминистрирование",
			ДопКонфигурация,
			120000
	);
	
	АдаптерКодОтвета = Адаптер.КодОтвета;
	АдаптерОписаниеОшибки = Адаптер.ОписаниеОшибки;
	
	Если Consumer = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		Результат = ConsumerGetMessagesНаСервере_(АдаптерКодОтвета, АдаптерОписаниеОшибки, Тема, СтарыеИлиНовые, КоличествоНаРаздел, Адаптер, Consumer);
		
		Адаптер.ConsumerRelease(Consumer);
		//АдаптерКодОтвета = Адаптер.КодОтвета;
		//АдаптерОписаниеОшибки = Адаптер.ОписаниеОшибки;
		
	Исключение
		Адаптер.ConsumerRelease(Consumer);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции
&НаСервереБезКонтекста
Функция ConsumerGetMessagesНаСервере_(АдаптерКодОтвета, АдаптерОписаниеОшибки, Тема, СтарыеИлиНовые, КоличествоНаРаздел, Адаптер, Consumer)
	
	Результат = Новый Массив;
	
	PartitionInfos = Адаптер.ConsumerGetPartitions(Consumer, Тема);
	АдаптерКодОтвета = Адаптер.КодОтвета;
	АдаптерОписаниеОшибки = Адаптер.ОписаниеОшибки;
	Если PartitionInfos = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Partitions = Новый Массив;
	Для Каждого PartitionInfo Из PartitionInfos Цикл
		Partitions.Добавить(Новый ФиксированнаяСтруктура("topic, partition", Тема, PartitionInfo.partition));
	КонецЦикла;
	
	Успех = Адаптер.ConsumerAssign(Consumer, Partitions);
	АдаптерКодОтвета = Адаптер.КодОтвета;
	АдаптерОписаниеОшибки = Адаптер.ОписаниеОшибки;
	Если Успех <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СостояниеЧтения = Новый Соответствие;
	
	Для Каждого TopicPartition Из Partitions Цикл
		СостояниеЧтенияТемы = СостояниеЧтения.Получить(TopicPartition.topic);
		Если СостояниеЧтенияТемы = Неопределено Тогда
			СостояниеЧтенияТемы = Новый Соответствие;
			СостояниеЧтения.Вставить(TopicPartition.topic, СостояниеЧтенияТемы);
		КонецЕсли;
		СостояниеЧтенияРаздела = Новый Структура;
		СостояниеЧтенияТемы.Вставить(TopicPartition.partition, СостояниеЧтенияРаздела);
	КонецЦикла;
	
	BeginningOffsets = Адаптер.ConsumerGetBeginningOffsets(Consumer, Partitions);
	Если BeginningOffsets = Неопределено Тогда
		ВызватьИсключение Строка(Адаптер.КодОтвета) + " " + Адаптер.ОписаниеОшибки;
	КонецЕсли;
	Для Каждого TopicOffsets Из BeginningOffsets Цикл
		Для Каждого PartitionOffset Из TopicOffsets.offsets Цикл
			СостояниеЧтенияРаздела = СостояниеЧтения[TopicOffsets.topic][PartitionOffset.partition];
			СостояниеЧтенияРаздела.Вставить("НачальноеСмещение", partitionOffset.offset);
		КонецЦикла;
	КонецЦикла;
	
	EndOffsets = Адаптер.ConsumerGetEndOffsets(Consumer, Partitions);
	Если EndOffsets = Неопределено Тогда
		ВызватьИсключение Строка(Адаптер.КодОтвета) + " " + Адаптер.ОписаниеОшибки;
	КонецЕсли;
	Для Каждого TopicOffsets Из EndOffsets Цикл
		Для Каждого PartitionOffset Из TopicOffsets.offsets Цикл
			СостояниеЧтенияРаздела = СостояниеЧтения[TopicOffsets.topic][PartitionOffset.partition];
			СостояниеЧтенияРаздела.Вставить("КонечноеСмещение", partitionOffset.offset);
		КонецЦикла;
	КонецЦикла;
	
	ОсталосьРазделов = 0;
	
	Для Каждого КлючЗначениеТема Из СостояниеЧтения Цикл
		Для Каждого КлючЗначениеРаздел Из КлючЗначениеТема.Значение Цикл
			
			СостояниеЧтенияРаздела = КлючЗначениеРаздел.Значение;
			
			Если СтарыеИлиНовые = "Старые" Тогда
				СостояниеЧтенияРаздела.КонечноеСмещение = Мин(СостояниеЧтенияРаздела.КонечноеСмещение, СостояниеЧтенияРаздела.НачальноеСмещение + КоличествоНаРаздел);
			ИначеЕсли СтарыеИлиНовые = "Новые" Тогда
				СостояниеЧтенияРаздела.НачальноеСмещение = Макс(СостояниеЧтенияРаздела.НачальноеСмещение, СостояниеЧтенияРаздела.КонечноеСмещение - КоличествоНаРаздел);
			Иначе
				ВызватьИсключение "Неожиданное состояние.";
			КонецЕсли;
			
			СостояниеЧтенияРаздела.Вставить("ТекущееСмещение", СостояниеЧтенияРаздела.НачальноеСмещение);
			
			Если СостояниеЧтенияРаздела.ТекущееСмещение < СостояниеЧтенияРаздела.КонечноеСмещение Тогда
				ОсталосьРазделов = ОсталосьРазделов + 1;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
		
	Если ОсталосьРазделов = 0 Тогда
		Возврат Результат;
	КонецЕсли;
		
	Для Каждого КлючЗначениеТема Из СостояниеЧтения Цикл
		Для Каждого КлючЗначениеРаздел Из КлючЗначениеТема.Значение Цикл
			
			СостояниеЧтенияРаздела = КлючЗначениеРаздел.Значение;
			
			Успех = Адаптер.ConsumerSeek(Consumer, КлючЗначениеТема.Ключ, КлючЗначениеРаздел.Ключ, СостояниеЧтенияРаздела.ТекущееСмещение);
			АдаптерКодОтвета = Адаптер.КодОтвета;
			АдаптерОписаниеОшибки = Адаптер.ОписаниеОшибки;
			Если Успех <> Истина Тогда
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Пока ОсталосьРазделов > 0 Цикл
		
		Records = Адаптер.ConsumerPoll(Consumer, 30000);
		АдаптерКодОтвета = Адаптер.КодОтвета;
		АдаптерОписаниеОшибки = Адаптер.ОписаниеОшибки;
		Если Records = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого Record Из Records Цикл
			
			Результат.Добавить(Record);
			
			СостояниеЧтенияРаздела = СостояниеЧтения[Record.topic][Record.partition];
			
			ПредыдущееСмещение = СостояниеЧтенияРаздела.ТекущееСмещение;
			СостояниеЧтенияРаздела.ТекущееСмещение = Record.offset + 1;
			
			Если ПредыдущееСмещение < СостояниеЧтенияРаздела.КонечноеСмещение
			И СостояниеЧтенияРаздела.ТекущееСмещение >= СостояниеЧтенияРаздела.КонечноеСмещение Тогда
				ОсталосьРазделов = ОсталосьРазделов - 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

