&НаКлиенте
Процедура ГруппаConsumerИзменитьПозицию(ТекущаяСтрока)
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Или (СтрСравнить(СтрокаГруппа.Тип, "CLASSIC") <> 0 И СтрСравнить(СтрокаГруппа.Тип, "CONSUMER") <> 0) Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ГруппаId"	, СтрокаГруппа.Id);
	ПараметрыФормы.Вставить("Тема"		, ТекущаяСтрока.Тема);
	ПараметрыФормы.Вставить("Раздел"	, ТекущаяСтрока.Раздел);
	ПараметрыФормы.Вставить("Позиция"	, ТекущаяСтрока.Позиция);
	ПараметрыФормы.Вставить("Метаданные", ТекущаяСтрока.Метаданные);
	
	ОткрытьФорму(
			"Обработка.КафкаАдминистрирование.Форма.РедактированиеПозицииГруппы",
			ПараметрыФормы,
			ЭтаФорма,
			,
			,
			,
			Новый ОписаниеОповещения("ГруппаConsumerИзменитьПозициюПриЗакрытииФормы", ЭтаФорма),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаConsumerИзменитьПозициюПриЗакрытииФормы(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	GroupId = РезультатЗакрытия.ГруппаId;
	
	TopicPartitionOffsetMetadata = Новый Структура;
	TopicPartitionOffsetMetadata.Вставить("topic", РезультатЗакрытия.Тема);
	TopicPartitionOffsetMetadata.Вставить("partition", РезультатЗакрытия.Раздел);
	TopicPartitionOffsetMetadata.Вставить("offset", РезультатЗакрытия.Позиция);
	Если ЗначениеЗаполнено(РезультатЗакрытия.Метаданные) Тогда
		TopicPartitionOffsetMetadata.Вставить("metadata", РезультатЗакрытия.Метаданные);
	КонецЕсли;
	
	Offsets = Новый Массив;
	Offsets.Добавить(TopicPartitionOffsetMetadata);
	
	Успех = AdminAlterConsumerGroupOffsetsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, GroupId, Offsets);
	
	Если Успех = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ГруппаConsumerПозицииЗаполнить();
		
КонецПроцедуры

