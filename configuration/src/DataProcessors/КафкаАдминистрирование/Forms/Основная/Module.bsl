КонецПроцедуры

&НаКлиенте
Процедура ГруппаShareОбновить(Перечитать = Ложь)
	
	ГруппаShareСбросить();
	
	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрСравнить(СтрокаГруппа.Тип, "SHARE") <> 0 Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	groupDescription = Неопределено;
	
	Если Перечитать Или Не СтрокаГруппа.Данные.Свойство("description", groupDescription) Тогда
		
		groupDescription = AdminDescribeShareGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаГруппа.Id, Истина);
		
		Если groupDescription = Неопределено Тогда
			Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		СтрокаГруппа.Данные.Вставить("description", groupDescription);
		
	КонецЕсли;
	
	ГруппаShareId = groupDescription.groupId;
	ГруппаShareСостояние = groupDescription.groupState;
	Если groupDescription.coordinator <> Неопределено Тогда
		ГруппаShareКоординатор = groupDescription.coordinator.host + ":" + Формат(groupDescription.coordinator.port, "ЧН=0; ЧГ=0");
	КонецЕсли;
	Если groupDescription.groupEpoch <> Неопределено Тогда
		ГруппаShareПоколение = Формат(groupDescription.groupEpoch, "ЧН=0");
	КонецЕсли;
	Если groupDescription.targetAssignmentEpoch <> Неопределено Тогда
		ГруппаShareПоколениеЦелевогоНазначения = Формат(groupDescription.targetAssignmentEpoch, "ЧН=0");
	КонецЕсли;
	
	Для Каждого memberDescription Из groupDescription.members Цикл
		
		СтрокаУчастник = ТаблицаГруппаShareУчастники.Добавить();
		СтрокаУчастник.ПолучательId = memberDescription.consumerId;
		СтрокаУчастник.КлиентId = memberDescription.clientId;
		СтрокаУчастник.Компьютер = memberDescription.host;
		Если memberDescription.memberEpoch <> Неопределено Тогда
			СтрокаУчастник.Поколение = Формат(memberDescription.memberEpoch, "ЧН=0");
		КонецЕсли;
		
		Для Каждого topicPartition Из memberDescription.assignment Цикл
			СтрокаНазначение = ТаблицаГруппаУчастникиНазначение.Добавить();
			СтрокаНазначение.ПолучательId = СтрокаУчастник.ПолучательId;
			СтрокаНазначение.Тема = topicPartition.topic;
			СтрокаНазначение.Раздел = topicPartition.partition;
		КонецЦикла;			
		
	КонецЦикла;
	
	Если groupDescription.authorizedOperations <> Неопределено Тогда
		Для Каждого aclOperation Из groupDescription.authorizedOperations Цикл
			СтрокаОперация = ТаблицаГруппаРазрешенныеОперации.Добавить();
			СтрокаОперация.Операция = aclOperation;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаГруппаShareУчастники.Сортировать("ПолучательId");
	ТаблицаГруппаУчастникиНазначение.Сортировать("ПолучательId, Тема, Раздел");
	ТаблицаГруппаРазрешенныеОперации.Сортировать("Операция");	
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаStreamsСбросить()
	
	ГруппаStreamsId = Неопределено;
	ГруппаStreamsСостояние = Неопределено;
	ГруппаStreamsКоординатор = Неопределено;
	ГруппаStreamsПоколение = Неопределено;
	ГруппаStreamsПоколениеЦелевогоНазначения = Неопределено;
	ГруппаStreamsПоколениеТопологии = Неопределено;
	
	ТаблицаГруппаStreamsУчастники.Очистить();
	ТаблицаГруппаРазрешенныеОперации.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаStreamsОбновить(Перечитать = Ложь)
	
	ГруппаStreamsСбросить();
		
	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрСравнить(СтрокаГруппа.Тип, "STREAMS") <> 0 Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	groupDescription = Неопределено;
	
	Если Перечитать Или Не СтрокаГруппа.Данные.Свойство("description", groupDescription) Тогда
		
		groupDescription = AdminDescribeStreamsGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаГруппа.Id, Истина);
		
		Если groupDescription = Неопределено Тогда
			Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		СтрокаГруппа.Данные.Вставить("description", groupDescription);
		
	КонецЕсли;
	
	ГруппаStreamsId = groupDescription.groupId;
	ГруппаStreamsСостояние = groupDescription.groupState;
	Если groupDescription.coordinator <> Неопределено Тогда
		ГруппаStreamsКоординатор = groupDescription.coordinator.host + ":" + Формат(groupDescription.coordinator.port, "ЧН=0; ЧГ=0");
	КонецЕсли;
	Если groupDescription.groupEpoch <> Неопределено Тогда
		ГруппаStreamsПоколение = Формат(groupDescription.groupEpoch, "ЧН=0");
	КонецЕсли;
	Если groupDescription.targetAssignmentEpoch <> Неопределено Тогда
		ГруппаStreamsПоколениеЦелевогоНазначения = Формат(groupDescription.targetAssignmentEpoch, "ЧН=0");
	КонецЕсли;
	Если groupDescription.topologyEpoch <> Неопределено Тогда
		ГруппаStreamsПоколениеТопологии = Формат(groupDescription.topologyEpoch, "ЧН=0");
	КонецЕсли;
	
	Для Каждого memberDescription Из groupDescription.members Цикл
		
		СтрокаУчастник = ТаблицаГруппаStreamsУчастники.Добавить();
		СтрокаУчастник.УчастникId = memberDescription.memberId;
		Если memberDescription.memberEpoch <> Неопределено Тогда
			СтрокаУчастник.Поколение = Формат(memberDescription.memberEpoch, "ЧН=0");
		КонецЕсли;
		СтрокаУчастник.КлиентId = memberDescription.clientId;
		СтрокаУчастник.Компьютер = memberDescription.clientHost;
		Если memberDescription.instanceId <> Неопределено Тогда
			СтрокаУчастник.ЭкземплярId = memberDescription.instanceId;
		КонецЕсли;
		СтрокаУчастник.ПроцессId = memberDescription.processId;
		СтрокаУчастник.ЭтоКлассическийУчастник = memberDescription.isClassic;
				
	КонецЦикла;
	
	Если groupDescription.authorizedOperations <> Неопределено Тогда
		Для Каждого aclOperation Из groupDescription.authorizedOperations Цикл
			СтрокаОперация = ТаблицаГруппаРазрешенныеОперации.Добавить();
			СтрокаОперация.Операция = aclOperation;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаГруппаStreamsУчастники.Сортировать("ПолучательId");
	ТаблицаГруппаРазрешенныеОперации.Сортировать("Операция");	
	
КонецПроцедуры

