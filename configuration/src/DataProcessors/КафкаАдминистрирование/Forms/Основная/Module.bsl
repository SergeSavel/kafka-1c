КонецПроцедуры

&НаКлиенте
Процедура ТемаСмещенияСбросить()
	
	ТаблицаТемаСмещения.Очистить();
	ТаблицаТемаСмещенияКоличество = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаСмещенияОбновить()
	
	ТемаСмещенияСбросить();
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если СтрокаТема = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТекущаяТема = СтрокаТема.Имя;
	
	ТекущиеРазделы = Новый Массив;
	Для Каждого partitionDescription Из СтрокаТема.Описание.partitions Цикл
		ТекущиеРазделы.Добавить(partitionDescription.partition);
	КонецЦикла;
	
	СмещенияТемы = ТемаСмещенияОбновитьНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ТекущаяТема, ТекущиеРазделы);
	
	Если СмещенияТемы = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СмещенияТемы Цикл
		
		СмещенияРаздела = КлючЗначение.Значение;
		
		Строка = ТаблицаТемаСмещения.Добавить();
		Строка.Раздел = КлючЗначение.Ключ;
		Строка.НачальноеСмещение = СмещенияРаздела.НачальноеСмещение;
		Строка.НачальноеСмещениеМоментВремени = ПредставлениеМоментаВремени(СмещенияРаздела.НачальноеСмещениеМоментВремени);
		Строка.КонечноеСмещение = СмещенияРаздела.КонечноеСмещение;
		Строка.КонечноеСмещениеМоментВремени = ПредставлениеМоментаВремени(СмещенияРаздела.КонечноеСмещениеМоментВремени);
		
		Строка.Количество = Строка.КонечноеСмещение - Строка.НачальноеСмещение;
		ТаблицаТемаСмещенияКоличество = ТаблицаТемаСмещенияКоличество + Строка.Количество;
		
	КонецЦикла;
		
	ТаблицаТемаСмещения.Сортировать("Раздел");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТемаСмещенияОбновитьНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, Тема, Разделы)
	
	Partitions = Новый Массив;
	Для Каждого Раздел Из Разделы Цикл
		Partitions.Добавить(Новый Структура("topic, partition", Тема, Раздел));
	КонецЦикла;
	
	earliestOffsets = AdminListEarliestOffsets(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, Partitions);
	Если earliestOffsets = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	latestOffsets = AdminListLatestOffsets(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, Partitions);
	Если latestOffsets = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Соответствие;
	
	Для Каждого offsetListing Из earliestOffsets Цикл
		
		Смещения = Результат.Получить(offsetListing.partition);
		
		Если Смещения = Неопределено Тогда
			Смещения = Новый Структура;
			Результат.Вставить(offsetListing.partition, Смещения);
		КонецЕсли;
		
		Смещения.Вставить("НачальноеСмещение", offsetListing.offset);
		Смещения.Вставить("НачальноеСмещениеМоментВремени", offsetListing.timestamp);
		
	КонецЦикла;
	
	Для Каждого offsetListing Из latestOffsets Цикл
		
		Смещения = Результат.Получить(offsetListing.partition);
		
		Если Смещения = Неопределено Тогда
			Смещения = Новый Структура;
			Результат.Вставить(offsetListing.partition, Смещения);
		КонецЕсли;
		
		Смещения.Вставить("КонечноеСмещение", offsetListing.offset);
		Смещения.Вставить("КонечноеСмещениеМоментВремени", offsetListing.timestamp);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Групппы

&НаКлиенте
Процедура ГруппыКомандаОбновить(Команда)
	
	ГруппыОбновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыСбросить()
	
	ТаблицаГруппы.Очистить();
	
	ГруппаClassicСбросить();
	
	ГруппаConsumerСбросить();
	
	ГруппаShareСбросить();
	
	ГруппаStreamsСбросить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыОбновить()
	
	ГруппыСбросить();
	
	Если АдаптерПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	groups = AdminListGroupsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin);
	Если groups = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого groupInfo Из groups Цикл
		
		Строка = ТаблицаГруппы.Добавить();
		Строка.Id = groupInfo.groupId;		
		Если groupInfo.type <> Неопределено Тогда
			Строка.Тип = groupInfo.type;
		КонецЕсли;
		Строка.Протокол = groupInfo.protocol;
		Если groupInfo.groupState <> Неопределено Тогда
			Строка.Состояние = groupInfo.groupState;
		КонецЕсли;
		Строка.ЭтоПростаяГруппаПолучателей = groupInfo.simpleConsumerGroup;
		Строка.Данные = Новый Структура;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаГруппыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Элементы.НадписьНеизвестнаяГруппа.Заголовок = "";;
		
		Элементы.ГруппаГруппа.ТекущаяСтраница = Элементы.ГруппаГруппаНеизвестно;
		
		ГруппыОбновить();
		
	Иначе
		
		ПодключитьОбработчикОжидания("ГруппыПриАктивизацииСтроки", 0.1, Истина); 
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено И СтрСравнить(ТекущиеДанные.Тип, "CLASSIC") = 0 Тогда
		
		ГруппаClassicОбновить();
		
		Элементы.ГруппаГруппа.ТекущаяСтраница = Элементы.ГруппаГруппаClassic;
		
	ИначеЕсли ТекущиеДанные <> Неопределено И СтрСравнить(ТекущиеДанные.Тип, "CONSUMER") = 0 Тогда
		
		ГруппаConsumerОбновить();
		
		Элементы.ГруппаГруппа.ТекущаяСтраница = Элементы.ГруппаГруппаConsumer;
		
	ИначеЕсли ТекущиеДанные <> Неопределено И СтрСравнить(ТекущиеДанные.Тип, "SHARE") = 0 Тогда
		
		ГруппаShareОбновить();
		
		Элементы.ГруппаГруппа.ТекущаяСтраница = Элементы.ГруппаГруппаShare;
		
	ИначеЕсли ТекущиеДанные <> Неопределено И СтрСравнить(ТекущиеДанные.Тип, "STREAMS") = 0 Тогда
		
		ГруппаStreamsОбновить();
		
		Элементы.ГруппаГруппа.ТекущаяСтраница = Элементы.ГруппаГруппаStreams;
		
	Иначе
		
		Если ТекущиеДанные = Неопределено Тогда
			Элементы.НадписьНеизвестнаяГруппа.Заголовок = "";
		Иначе
			Элементы.НадписьНеизвестнаяГруппа.Заголовок = "Неизвестный тип группы: """ + ТекущиеДанные.Тип + """.";
		КонецЕсли;
		
		Элементы.ГруппаГруппа.ТекущаяСтраница = Элементы.ГруппаГруппаНеизвестно;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ГруппыКомандаУдалить(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ГруппаId", ТекущиеДанные.Id);
	ПараметрыОповещения.Вставить("ГруппаТип", ТекущиеДанные.Тип);
	
	ПоказатьВопрос(
			Новый ОписаниеОповещения("ГруппыУдалитьПриОтветеНаВопрос", ЭтаФорма, ПараметрыОповещения),
			"Вы действительно хотите удалить " + НРег(ТекущиеДанные.Тип) + "-группу """ + ТекущиеДанные.Id + """?",
			РежимДиалогаВопрос.ДаНет,
			60,
			КодВозвратаДиалога.Нет,
			"Удаление " + НРег(ТекущиеДанные.Тип) + "-группы.",
			КодВозвратаДиалога.Нет
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыУдалитьПриОтветеНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаId = ДополнительныеПараметры.ГруппаId;
	ГруппаТип = ДополнительныеПараметры.ГруппаТип;
	
	Если СтрСравнить(ГруппаТип, "CLASSIC") = 0 Тогда
		
		Успех = AdminDeleteConsumerGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ГруппаId);
		
	ИначеЕсли СтрСравнить(ГруппаТип, "COMSUMER") = 0 Тогда
		
		Успех = AdminDeleteConsumerGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ГруппаId);
		
	ИначеЕсли СтрСравнить(ГруппаТип, "SHARE") = 0 Тогда
		
		Успех = AdminDeleteShareGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ГруппаId);
		
	ИначеЕсли СтрСравнить(ГруппаТип, "STREAMS") = 0 Тогда
		
		Успех = AdminDeleteStreamsGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ГруппаId);
		
	Иначе
		
		ВызватьИсключение "Неожиданный тип группы: """ + ГруппаТип + """.";
		
	КонецЕсли;
	
	Если Успех = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ГруппыОбновить();
	
КонецПроцедуры

#КонецОбласти

#Область Групппа

&НаКлиенте
Процедура ГруппаКомандаОбновить(Команда)
	
	ГруппаОбновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаОбновить()
	
	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	Если СтрСравнить(СтрокаГруппа.Тип, "CLASSIC") = 0 Тогда
		
		ГруппаClassicОбновить(Истина);
		
	ИначеЕсли СтрСравнить(СтрокаГруппа.Тип, "CONSUMER") = 0 Тогда
		
		ГруппаConsumerОбновить(Истина);
		
	ИначеЕсли СтрСравнить(СтрокаГруппа.Тип, "SHARE") = 0 Тогда
		
		ГруппаShareОбновить(Истина);		
		
	ИначеЕсли СтрСравнить(СтрокаГруппа.Тип, "STREAMS") = 0 Тогда
		
		ГруппаStreamsОбновить(Истина);
		
	Иначе
		
		ВызватьИсключение "Неожиданное состояние.";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаClassicСбросить()
	
	ГруппаClassicId = Неопределено;
	ГруппаClassicСостояние = Неопределено;
	ГруппаClassicПротокол = Неопределено;
	ГруппаClassicПротоколДанные = Неопределено;
	ГруппаClassicКоординатор = Неопределено;
	ГруппаClassicЭтоПростаяГруппаПолучателей = Неопределено;
	
	ТаблицаГруппаУчастники.Очистить();
	ТаблицаГруппаУчастникиНазначение.Очистить();
	ТаблицаГруппаУчастникиЦелевоеНазначение.Очистить();
	ТаблицаГруппаРазрешенныеОперации.Очистить();
	
	СтруктураОтбор = Новый ФиксированнаяСтруктура("ПолучательId", Строка(Новый УникальныйИдентификатор));
	Элементы.ТаблицаГруппаClassicУчастникиНазначение.ОтборСтрок = СтруктураОтбор;
	
	ГруппаConsumerПозицииСбросить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаClassicОбновить(Перечитать = Ложь)
	
	ГруппаClassicСбросить();

	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрСравнить(СтрокаГруппа.Тип, "CLASSIC") <> 0 Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	groupDescription = Неопределено;
	
	Если Перечитать Или Не СтрокаГруппа.Данные.Свойство("description", groupDescription) Тогда
		
		groupDescription = AdminDescribeClassicGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаГруппа.Id, Истина);
		
		Если groupDescription = Неопределено Тогда
			Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		СтрокаГруппа.Данные.Вставить("description", groupDescription);
		
	КонецЕсли;
	
	ГруппаClassicId = groupDescription.groupId;
	ГруппаClassicСостояние = groupDescription.state;
	ГруппаClassicПротокол = groupDescription.protocol;
	ГруппаClassicПротоколДанные = groupDescription.protocolData;
	Если groupDescription.coordinator <> Неопределено Тогда
		ГруппаClassicКоординатор = groupDescription.coordinator.host + ":" + Формат(groupDescription.coordinator.port, "ЧН=0; ЧГ=0");
	КонецЕсли;
	ГруппаClassicЭтоПростаяГруппаПолучателей = groupDescription.simpleConsumerGroup;
	
	Для Каждого memberDescription Из groupDescription.members Цикл
		
		СтрокаУчастник = ТаблицаГруппаУчастники.Добавить();
		СтрокаУчастник.ПолучательId = memberDescription.consumerId;
		Если memberDescription.groupInstanceId <> Неопределено Тогда
			СтрокаУчастник.ЭкземплярId = memberDescription.groupInstanceId;
		КонецЕсли;
		СтрокаУчастник.КлиентId = memberDescription.clientId;
		СтрокаУчастник.Компьютер = memberDescription.host;
		Если memberDescription.memberEpoch <> Неопределено Тогда
			СтрокаУчастник.Поколение = Формат(memberDescription.memberEpoch, "ЧН=0");
		КонецЕсли;
		Если memberDescription.upgraded <> Неопределено Тогда
			СтрокаУчастник.Обновлен = memberDescription.upgraded;
		КонецЕсли;
		
		Для Каждого topicPartition Из memberDescription.assignment Цикл
			СтрокаНазначение = ТаблицаГруппаУчастникиНазначение.Добавить();
			СтрокаНазначение.ПолучательId = СтрокаУчастник.ПолучательId;
			СтрокаНазначение.Тема = topicPartition.topic;
			СтрокаНазначение.Раздел = topicPartition.partition;
		КонецЦикла;			
		
		Если memberDescription.targetAssignment <> Неопределено Тогда
			Для Каждого topicPartition Из memberDescription.targetAssignment Цикл
				СтрокаНазначение = ТаблицаГруппаУчастникиЦелевоеНазначение.Добавить();
				СтрокаНазначение.ПолучательId = СтрокаУчастник.ПолучательId;
				СтрокаНазначение.Тема = topicPartition.topic;
				СтрокаНазначение.Раздел = topicPartition.partition;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если groupDescription.authorizedOperations <> Неопределено Тогда
		Для Каждого aclOperation Из groupDescription.authorizedOperations Цикл
			СтрокаОперация = ТаблицаГруппаРазрешенныеОперации.Добавить();
			СтрокаОперация.Операция = aclOperation;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаГруппаУчастники.Сортировать("ПолучательId");
	ТаблицаГруппаУчастникиНазначение.Сортировать("ПолучательId, Тема, Раздел");
	ТаблицаГруппаУчастникиЦелевоеНазначение.Сортировать("ПолучательId, Тема, Раздел");
	ТаблицаГруппаРазрешенныеОперации.Сортировать("Операция");	
	
	Если Элементы.ГруппаГруппаClassicСтраницы.ТекущаяСтраница = Элементы.ГруппаГруппаClassicПозиции Тогда
		ГруппаConsumerПозицииЗаполнить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаConsumerСбросить()
	
	ГруппаConsumerId = Неопределено;
	ГруппаConsumerТип = Неопределено;
	ГруппаConsumerСостояние = Неопределено;
	ГруппаConsumerКоординатор = Неопределено;
	ГруппаConsumerНазначениеРазделов = Неопределено;
	ГруппаConsumerПоколение = Неопределено;
	ГруппаConsumerПоколениеЦелевогоНазначения = Неопределено;
	ГруппаConsumerЭтоПростаяГруппаПолучателей = Неопределено;
	
	ТаблицаГруппаУчастники.Очистить();
	ТаблицаГруппаУчастникиНазначение.Очистить();
	ТаблицаГруппаУчастникиЦелевоеНазначение.Очистить();
	ТаблицаГруппаРазрешенныеОперации.Очистить();
	
	СтруктураОтбор = Новый ФиксированнаяСтруктура("ПолучательId", Строка(Новый УникальныйИдентификатор));
	Элементы.ТаблицаГруппаConsumerУчастникиНазначение.ОтборСтрок = СтруктураОтбор;
	Элементы.ТаблицаГруппаConsumerУчастникиЦелевоеНазначение.ОтборСтрок = СтруктураОтбор;
	
	ГруппаConsumerПозицииСбросить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаConsumerОбновить(Перечитать = Ложь)
	
	ГруппаConsumerСбросить();

	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрСравнить(СтрокаГруппа.Тип, "CONSUMER") <> 0 Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	groupDescription = Неопределено;
	
	Если Перечитать Или Не СтрокаГруппа.Данные.Свойство("description", groupDescription) Тогда
		
		groupDescription = AdminDescribeConsumerGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаГруппа.Id, Истина);
		
		Если groupDescription = Неопределено Тогда
			Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		СтрокаГруппа.Данные.Вставить("description", groupDescription);
		
	КонецЕсли;
	
	ГруппаConsumerId = groupDescription.groupId;
	ГруппаConsumerТип = groupDescription.type;
	ГруппаConsumerСостояние = groupDescription.groupState;
	Если groupDescription.coordinator <> Неопределено Тогда
		ГруппаConsumerКоординатор = groupDescription.coordinator.host + ":" + Формат(groupDescription.coordinator.port, "ЧН=0; ЧГ=0");
	КонецЕсли;
	ГруппаConsumerНазначениеРазделов = groupDescription.partitionAssignor;
	Если groupDescription.groupEpoch <> Неопределено Тогда
		ГруппаConsumerПоколение = Формат(groupDescription.groupEpoch, "ЧН=0");
	КонецЕсли;
	Если groupDescription.targetAssignmentEpoch <> Неопределено Тогда
		ГруппаConsumerПоколениеЦелевогоНазначения = Формат(groupDescription.targetAssignmentEpoch, "ЧН=0");
	КонецЕсли;
	ГруппаConsumerЭтоПростаяГруппаПолучателей = groupDescription.simpleConsumerGroup;
	
	Для Каждого memberDescription Из groupDescription.members Цикл
		
		СтрокаУчастник = ТаблицаГруппаУчастники.Добавить();
		СтрокаУчастник.ПолучательId = memberDescription.consumerId;
		Если memberDescription.groupInstanceId <> Неопределено Тогда
			СтрокаУчастник.ЭкземплярId = memberDescription.groupInstanceId;
		КонецЕсли;
		СтрокаУчастник.КлиентId = memberDescription.clientId;
		СтрокаУчастник.Компьютер = memberDescription.host;
		Если memberDescription.memberEpoch <> Неопределено Тогда
			СтрокаУчастник.Поколение = Формат(memberDescription.memberEpoch, "ЧН=0");
		КонецЕсли;
		Если memberDescription.upgraded <> Неопределено Тогда
			СтрокаУчастник.Обновлен = memberDescription.upgraded;
		КонецЕсли;
		
		Для Каждого topicPartition Из memberDescription.assignment Цикл
			СтрокаНазначение = ТаблицаГруппаУчастникиНазначение.Добавить();
			СтрокаНазначение.ПолучательId = СтрокаУчастник.ПолучательId;
			СтрокаНазначение.Тема = topicPartition.topic;
			СтрокаНазначение.Раздел = topicPartition.partition;
		КонецЦикла;			
		
		Если memberDescription.targetAssignment <> Неопределено Тогда
			Для Каждого topicPartition Из memberDescription.targetAssignment Цикл
				СтрокаНазначение = ТаблицаГруппаУчастникиЦелевоеНазначение.Добавить();
				СтрокаНазначение.ПолучательId = СтрокаУчастник.ПолучательId;
				СтрокаНазначение.Тема = topicPartition.topic;
				СтрокаНазначение.Раздел = topicPartition.partition;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если groupDescription.authorizedOperations <> Неопределено Тогда
		Для Каждого aclOperation Из groupDescription.authorizedOperations Цикл
			СтрокаОперация = ТаблицаГруппаРазрешенныеОперации.Добавить();
			СтрокаОперация.Операция = aclOperation;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаГруппаУчастники.Сортировать("ПолучательId");
	ТаблицаГруппаУчастникиНазначение.Сортировать("ПолучательId, Тема, Раздел");
	ТаблицаГруппаУчастникиЦелевоеНазначение.Сортировать("ПолучательId, Тема, Раздел");
	ТаблицаГруппаРазрешенныеОперации.Сортировать("Операция");	
	
	Если Элементы.ГруппаГруппаConsumerСтраницы.ТекущаяСтраница = Элементы.ГруппаГруппаConsumerПозиции Тогда
		ГруппаConsumerПозицииЗаполнить();
	КонецЕсли;
	
КонецПроцедуры

