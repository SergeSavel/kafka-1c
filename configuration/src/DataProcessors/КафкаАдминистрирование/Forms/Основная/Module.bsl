&НаКлиенте
Процедура ГруппаConsumerПозицииСбросить()
	
	ТаблицаГруппаПозиции.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаConsumerПозицииЗаполнить()
	
	ГруппаConsumerПозицииСбросить();
	
	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Или (СтрСравнить(СтрокаГруппа.Тип, "CLASSIC") <> 0 И СтрСравнить(СтрокаГруппа.Тип, "CONSUMER") <> 0) Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	groupOffsets = AdminListConsumerGroupOffsetsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаГруппа.Id);
			
	Если groupOffsets = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Partitions = Новый Массив;
	ТаблицаГруппаПозицииОтставание_ = 0;
	
	Для Каждого topicPartitionOffsetMetadata Из groupOffsets Цикл
		
		СтрокаГруппаПозиции = ТаблицаГруппаПозиции.Добавить();
		
		Если topicPartitionOffsetMetadata.topic <> Неопределено Тогда
			СтрокаГруппаПозиции.Тема = topicPartitionOffsetMetadata.topic;
		КонецЕсли;
		
		Если topicPartitionOffsetMetadata.partition <> Неопределено Тогда
			СтрокаГруппаПозиции.Раздел = topicPartitionOffsetMetadata.partition;
		КонецЕсли;
		
		Если topicPartitionOffsetMetadata.offset <> Неопределено Тогда
			СтрокаГруппаПозиции.Позиция = topicPartitionOffsetMetadata.offset;
		КонецЕсли;
		
		Если topicPartitionOffsetMetadata.leaderEpoch <> Неопределено Тогда
			СтрокаГруппаПозиции.ПоколениеЛидера = Формат(topicPartitionOffsetMetadata.leaderEpoch, "ЧН=0");
		КонецЕсли;
		
		Если topicPartitionOffsetMetadata.metadata <> Неопределено Тогда
			СтрокаГруппаПозиции.Метаданные = topicPartitionOffsetMetadata.metadata;
		КонецЕсли;
		
		СтрокаГруппаПозиции.Отставание = "n/a";
		
		Если topicPartitionOffsetMetadata.topic <> Неопределено
		И topicPartitionOffsetMetadata.partition <> Неопределено
		И topicPartitionOffsetMetadata.offset <> Неопределено Тогда
			TopicPartiton = Новый Структура;
			TopicPartiton.Вставить("topic", topicPartitionOffsetMetadata.topic);
			TopicPartiton.Вставить("partition", topicPartitionOffsetMetadata.partition);
			Partitions.Добавить(TopicPartiton);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Partitions.Количество() > 0 Тогда
		
		latestOffsets = AdminListLatestOffsets(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, Partitions);
		
		Если latestOffsets = Неопределено Тогда
			Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		СтруктураПоиск = Новый Структура("Тема, Раздел");
		
		Для Каждого latestOffset Из latestOffsets Цикл
			
			СтруктураПоиск.Тема = latestOffset.topic;
			СтруктураПоиск.Раздел = latestOffset.partition;
			
			НайденныеСтроки = ТаблицаГруппаПозиции.НайтиСтроки(СтруктураПоиск);
			
			Для Каждого СтрокаГруппаПозиции Из НайденныеСтроки Цикл
				
				Отставание_ = latestOffset.offset - СтрокаГруппаПозиции.Позиция;
				СтрокаГруппаПозиции.Отставание = Формат(Отставание_, "ЧН=0");
				ТаблицаГруппаПозицииОтставание_ = ТаблицаГруппаПозицииОтставание_ + Отставание_;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТаблицаГруппаПозицииОтставание_) Тогда
			ТаблицаГруппаПозицииОтставание = Формат(ТаблицаГруппаПозицииОтставание_, "ЧН=0");
		КонецЕсли;
		
	КонецЕсли;
		
	ТаблицаГруппаПозиции.Сортировать("Тема, Раздел");
	
КонецПроцедуры

