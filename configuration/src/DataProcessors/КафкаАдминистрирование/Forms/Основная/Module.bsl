Процедура ГруппаConsumerУдалитьПозициюПриОтветеНаВопрос(РезультатВопроса, ДопПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	GroupId = ДопПараметры.ГруппаId;
	
	Partitions = Новый Массив;
	Для Каждого ИдентификаторСтроки Из ДопПараметры.ВыделенныеСтроки Цикл
		Строка = ТаблицаГруппаПозиции.НайтиПоИдентификатору(ИдентификаторСтроки);
		Partitions.Добавить(Новый Структура("topic, partition", Строка.Тема, Строка.Раздел));
	КонецЦикла;
	
	Успех = AdminDeleteConsumerGroupOffsetsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, GroupId, Partitions);
	
	Если Успех = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ГруппаConsumerПозицииЗаполнить();
	
КонецПроцедуры

