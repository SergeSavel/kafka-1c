	КонецЕсли;
		
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ГруппаId"	, СтрокаГруппа.Id);
	ДопПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	ПоказатьВопрос(
			Новый ОписаниеОповещения("ГруппаConsumerУдалитьПозициюПриОтветеНаВопрос", ЭтаФорма, ДопПараметры),
			"Вы действительно хотите удалить позиции чтения группы """ + СтрокаГруппа.Id + """?",
			РежимДиалогаВопрос.ДаНет,
			60,
			КодВозвратаДиалога.Нет,
			"Удаление позиций чтения группы",
			КодВозвратаДиалога.Нет
	);
	
