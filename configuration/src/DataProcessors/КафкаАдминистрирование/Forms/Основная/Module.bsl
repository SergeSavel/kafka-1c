#Область КлиентскиеПеременные

&НаКлиенте
Перем Admin;
&НаКлиенте
Перем АдаптерПараметры;
&НаКлиенте
Перем АдаптерКодОтвета;
&НаКлиенте
Перем АдаптерОписаниеОшибки;

#КонецОбласти

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Кластер = Константы.КафкаКластерПоУмолчанию.Получить();
	
	ВерсияПодсистемы = КафкаСервер.ВерсияПодсистемы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
			
	Если ЗначениеЗаполнено(Кластер) Тогда
		ПриИзмененииКластера();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
		
	Если Admin <> Неопределено И Не ЗавершениеРаботы Тогда
		Попытка
			AdminRelease();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Кластер

&НаКлиенте
Процедура КластерПриИзменении(Элемент)
	
	ПриИзмененииКластера();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКластера()
	
	УзелСбросить();
	
	ТемыСбросить();
	
	ГруппыСбросить();
	
	КонтрольДоступаСбросить();
	
	ScramПользователиСбросить();
	
	Если Admin <> Неопределено Тогда
		AdminRelease();
	КонецЕсли;
	
	АдаптерПараметры = Неопределено;
		
	Если Не ЗначениеЗаполнено(Кластер) Тогда
		Возврат;
	КонецЕсли;
	
	АдаптерПараметры = ПолучитьПараметрыАдаптера(Кластер);
	
	ВерсияШлюза_ = GetVersionНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки);
	Если ВерсияШлюза_ = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	ВерсияШлюза = ВерсияШлюза_;
	
	Если Не AdminCreate() Тогда
		Возврат;
	КонецЕсли;
		
	ПодключитьОбработчикОжидания("ПериодическийAdminTouch", 60, Ложь);
		
	КластерОбновить();
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыАдаптера(Кластер)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Кластеры.ШлюзАдрес КАК ШлюзАдрес,
	|	Кластеры.ШлюзПользователь КАК ШлюзПользователь,
	|	Кластеры.ШлюзПароль КАК ШлюзПароль,
	|	Кластеры.ШлюзТаймаут КАК ШлюзТаймаут
	|ИЗ
	|	Справочник.КафкаКластеры КАК Кластеры
	|ГДЕ
	|	Кластеры.Ссылка = &Кластер");
	Запрос.УстановитьПараметр("Кластер", Кластер);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение "Передан некорректный параметр.";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Результат = Новый Структура;
	Результат.Вставить("ШлюзАдрес", Выборка.ШлюзАдрес);
	Результат.Вставить("ШлюзПользователь", Выборка.ШлюзПользователь);
	Результат.Вставить("ШлюзПароль", Выборка.ШлюзПароль.Получить());
	Результат.Вставить("ШлюзТаймаут", Выборка.ШлюзТаймаут);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПериодическийAdminTouch()
	
	Если Admin = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Успех = AdminTouch();
	
	Если Не Успех Тогда
		Если АдаптерКодОтвета = 404 Тогда
			Admin = Неопределено;
		Иначе
			Сообщить(АдаптерОписаниеОшибки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КластерОбновить()
	
	УзелСбросить();
	
	КонтрольДоступаСбросить();
	
	ScramПользователиСбросить();
	
	clusterDescription = AdminDescribeClusterНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin);
	Если clusterDescription = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	КластерId = clusterDescription.clusterId;
	КластерКонтроллер = clusterDescription.controller.host + ":" + Формат(clusterDescription.controller.port, "ЧН=0; ЧГ=0");
	
	Для Каждого node Из clusterDescription.nodes Цикл
		Строка = ТаблицаУзлы.Добавить();
		Строка.Id = node.id;
		Строка.Сервер = node.host;
		Строка.Порт = node.port;
		Строка.Стойка = node.rack;
	КонецЦикла;
	
	ТаблицаУзлы.Сортировать("Id");
	
КонецПроцедуры

#КонецОбласти

#Область Узлы

&НаКлиенте
Процедура ТаблицаУзлыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УзелОбновить", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область Узел

&НаКлиенте
Процедура УзелСбросить()
	
	УзелКонфигурацияСбросить();
	
	УзелКаталогиСбросить();
	
КонецПроцедуры

&НаКлиенте
Процедура УзелОбновить()
	
	УзелСбросить();
	
	Если Элементы.ГруппаКластерУзлыСтраницы.ТекущаяСтраница = Элементы.ГруппаКластерУзлыКонфигурация Тогда
		УзелКонфигурацияОбновить();
	ИначеЕсли Элементы.ГруппаКластерУзлыСтраницы.ТекущаяСтраница = Элементы.ГруппаКластерУзлыКаталоги Тогда
		УзелКаталогиОбновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УзелКонфигурация

&НаКлиенте
Процедура УзелКонфигурацияКомандаОбновить(Команда)
	
	УзелКонфигурацияОбновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УзелКонфигурацияСбросить()
	
	ТаблицаУзелКонфигурация.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура УзелКонфигурацияОбновить()
	
	УзелКонфигурацияСбросить();
	
	СтрокаУзел = Элементы.ТаблицаУзлы.ТекущиеДанные;
	
	Если СтрокаУзел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	brokerConfigs = AdminDescribeBrokerConfigsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаУзел.Id);
	
	Если brokerConfigs = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого configEntry Из brokerConfigs Цикл
		
		Если configEntry.sensitive Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = ТаблицаУзелКонфигурация.Добавить();
		Строка.Имя = configEntry.name;
		Строка.Значение = configEntry.value;
		Строка.ТолькоЧтение = configEntry.readOnly;
		Строка.ПоУмолчанию = configEntry.default;
		
	КонецЦикла;
	
	ТаблицаУзелКонфигурация.Сортировать("Имя");
	
КонецПроцедуры

#КонецОбласти

#Область УзелКаталоги

&НаКлиенте
Процедура УзелКаталогиСбросить()
	
	ТаблицаБрокерКаталоги.Очистить();
	ТаблицаБрокерКаталогиРеплики.Очистить();
	
	СтруктураОтбор = Новый ФиксированнаяСтруктура("Каталог", Строка(Новый УникальныйИдентификатор));
	Элементы.ТаблицаБрокерКаталогиРеплики.ОтборСтрок = СтруктураОтбор;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаБрокерКаталогиПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаБрокерКаталоги.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		СтруктураОтбор = Новый ФиксированнаяСтруктура("Каталог", Строка(Новый УникальныйИдентификатор));
		Элементы.ТаблицаБрокерКаталогиРеплики.ОтборСтрок = СтруктураОтбор;
		
		УзелКаталогиОбновить();
		Возврат;
		
	КонецЕсли;
	
	СтруктураОтбор = Новый ФиксированнаяСтруктура("Каталог", ТекущиеДанные.Каталог);
	Элементы.ТаблицаБрокерКаталогиРеплики.ОтборСтрок = СтруктураОтбор;
	
КонецПроцедуры

&НаКлиенте
Процедура УзелКаталогиОбновить()
	
	УзелКаталогиСбросить();
	
	СтрокаУзел = Элементы.ТаблицаУзлы.ТекущиеДанные;
	
	Если СтрокаУзел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	brokerIds = Новый Массив;
	brokerIds.Добавить(СтрокаУзел.Id);
	
	clusterLogDirs = AdminDescribelogDirsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, brokerIds);
	
	Если clusterLogDirs = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого brokerLogDirs Из clusterLogDirs Цикл
		
		Для Каждого logDirDescription Из brokerLogDirs.logDirs Цикл
			
			РазмерКаталог = 0;
			
			СтрокаКаталог = ТаблицаБрокерКаталоги.Добавить();
			СтрокаКаталог.Каталог = logDirDescription.path;
			
			Если logDirDescription.errorMessage <> Неопределено Тогда
				СтрокаКаталог.Ошибка = logDirDescription.errorMessage;
			КонецЕсли;
			
			Для Каждого replicaInfo Из logDirDescription.replicaInfos Цикл
				
				СтрокаРеплика = ТаблицаБрокерКаталогиРеплики.Добавить();
				СтрокаРеплика.Каталог = logDirDescription.path;
				СтрокаРеплика.Тема = replicaInfo.topic;
				СтрокаРеплика.Раздел = replicaInfo.partition;
				СтрокаРеплика.РазмерКБ = Окр(replicaInfo.size / 1000);
				СтрокаРеплика.Отставание = replicaInfo.offsetLag;
				СтрокаРеплика.Будущий = replicaInfo.future;
				
				РазмерКаталог = РазмерКаталог + replicaInfo.size;
				
			КонецЦикла;
			
			СтрокаКаталог.РазмерКБ = Окр(РазмерКаталог / 1000);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаБрокерКаталоги.Сортировать("Каталог");
	ТаблицаБрокерКаталогиРеплики.Сортировать("РазмерКБ Убыв, Каталог, Тема, Раздел");
	
КонецПроцедуры

#КонецОбласти

#Область Темы

&НаКлиенте
Процедура ТаблицаТемыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТемыОбновить();
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ТемыПриАктивизацииСтроки", 0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыПриАктивизацииСтроки()
				
	ТемаОбновить();
					
КонецПроцедуры

&НаКлиенте
Процедура ТемыКомандаОбновить(Команда)
	
	ТемыОбновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыСбросить()
	
	ТаблицаТемы.Очистить();
	
	ТемаСбросить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыОбновить()
	
	ТемыСбросить();
	
	Если АдаптерПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	topics = AdminListTopicsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin);
	Если topics = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
		
	Для Каждого topic Из topics Цикл
		Строка = ТаблицаТемы.Добавить();
		Строка.Id = topic.id;
		Строка.Имя = topic.name;
		Строка.Внутренняя = topic.internal;
	КонецЦикла;
	
	ТаблицаТемы.Сортировать("Имя");
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыКомандаСоздать(Команда)
	
	Если АдаптерПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(
			"Обработка.КафкаАдминистрирование.Форма.СозданиеТемы",
			,
			ЭтаФорма,
			,
			,
			,
			Новый ОписаниеОповещения("ТемыСоздатьПриЗакрытииФормы", ЭтаФорма),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыСоздатьПриЗакрытииФормы(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	topicName = РезультатЗакрытия.ИмяТемы;
	
	numPartitions = РезультатЗакрытия.КоличествоРазделов;
	Если numPartitions = 0 Тогда
		numPartitions = Неопределено;
	КонецЕсли;
	
	replicationFactor = РезультатЗакрытия.КоэффициентРепликации;
	Если replicationFactor = 0 Тогда
		replicationFactor = Неопределено;
	КонецЕсли;
	
	result = AdminCreateTopicНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, topicName, numPartitions, replicationFactor);
	Если result = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Строка = ТаблицаТемы.Добавить();
	Строка.Id = result.topicId;
	Строка.Имя = topicName;
	Строка.Внутренняя = Ложь;
	
	ТаблицаТемы.Сортировать("Имя");
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыКомандаУдалить(Команда)
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если СтрокаТема = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ПоказатьВопрос(
			Новый ОписаниеОповещения("ТемыУдалитьПриОтветеНаВопрос", ЭтаФорма, Новый Структура("ТемаИмя", СтрокаТема.Имя)),
			"Вы действительно хотите удалить тему """ + СтрокаТема.Имя + """?",
			РежимДиалогаВопрос.ДаНет,
			60,
			КодВозвратаДиалога.Нет,
			"Удаление темы",
			КодВозвратаДиалога.Нет
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ТемыУдалитьПриОтветеНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТемаИмя = ДополнительныеПараметры.ТемаИмя;
	
	Успех = AdminDeleteTopicНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ТемаИмя);
	Если Успех = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ТемыОбновить();
	
КонецПроцедуры

#КонецОбласти

#Область Тема

&НаКлиенте
Процедура ТемаКомандаОбновить(Команда)
	
	ТемаОбновить(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаСбросить()
	
	ТемаИмя = Неопределено;
	ТемаId = Неопределено;
	ТемаВнутренняя = Неопределено;
	
	ТаблицаТемаРазделы.Очистить();
	
	ТаблицаТемаРазделыРеплики.Очистить();
	
	ТаблицаТемаРазрешенныеОперации.Очистить();
	
	ТемаКонфигурацияСбросить();
	
	ТемаСмещенияСбросить();
	
	ТемаДанныеСбросить();
	
	СтруктураОтбор = Новый ФиксированнаяСтруктура("Раздел", -9999);
	Элементы.ТаблицаТемаРазделыРеплики.ОтборСтрок = СтруктураОтбор;
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаОбновить(Перечитать = Ложь)
	
	ТемаСбросить();
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если СтрокаТема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	topicDescription = Неопределено;
	Если Перечитать Или СтрокаТема.Описание = Неопределено Тогда
		
		topicDescription = AdminDescribeTopicНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаТема.Имя);
		Если topicDescription = Неопределено Тогда
			Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		СтрокаТема.Описание = topicDescription;
				
	КонецЕсли;
	
	ТемаИмя = СтрокаТема.Описание.name;
	ТемаId = СтрокаТема.Описание.id;
	ТемаВнутренняя = СтрокаТема.Описание.internal;
	
	Для Каждого partitionInfo Из СтрокаТема.Описание.partitions Цикл
		
		СтрокаРаздел = ТаблицаТемаРазделы.Добавить();
		СтрокаРаздел.Раздел = partitionInfo.partition;
		
		Если partitionInfo.leader <> Неопределено Тогда
			СтрокаРаздел.Лидер = partitionInfo.leader.host + ":" + Формат(partitionInfo.leader.port, "ЧН=0; ЧГ=0");
		КонецЕсли;
		
		Для Каждого node Из partitionInfo.replicas Цикл
			
			СтрокаРеплика = ТаблицаТемаРазделыРеплики.Добавить();
			СтрокаРеплика.Раздел = partitionInfo.partition;
			СтрокаРеплика.Id = node.id;
			СтрокаРеплика.Сервер = node.host;
			СтрокаРеплика.Порт = node.port;
			СтрокаРеплика.Стойка = node.rack;
			
			Если partitionInfo.leader <> Неопределено И partitionInfo.leader.id = node.id Тогда
				СтрокаРеплика.Лидер = Истина;
			КонецЕсли;
			
			Если partitionInfo.isr <> Неопределено Тогда
				Для Каждого nodeId Из partitionInfo.isr Цикл
					Если nodeId = node.id Тогда
						СтрокаРеплика.ISR = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если partitionInfo.elr <> Неопределено Тогда
				Для Каждого nodeId Из partitionInfo.elr Цикл
					Если nodeId = node.id Тогда
						СтрокаРеплика.ELR = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если partitionInfo.lastKnownElr <> Неопределено Тогда
				Для Каждого nodeId Из partitionInfo.lastKnownElr Цикл
					Если nodeId = node.id Тогда
						СтрокаРеплика.ПоследнийELR = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если СтрокаТема.Описание.authorizedOperations <> Неопределено Тогда
		Для Каждого Operation Из СтрокаТема.Описание.authorizedOperations Цикл
			СтрокаОперация = ТаблицаТемаРазрешенныеОперации.Добавить();
			СтрокаОперация.Операция = Operation;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаТемаРазделы.Сортировать("Раздел");
	ТаблицаТемаРазделыРеплики.Сортировать("Раздел, Id");
	ТаблицаТемаРазрешенныеОперации.Сортировать("Операция");
	
	Если Элементы.ГруппаТемаСтраницы.ТекущаяСтраница = Элементы.ГруппаТемаКонфигурация Тогда
		ТемаКонфигурацияОбновить();
	ИначеЕсли Элементы.ГруппаТемаСтраницы.ТекущаяСтраница = Элементы.ГруппаТемаСмещения Тогда
		ТемаСмещенияОбновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаКомандаСоздатьРазделы(Команда)
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если СтрокаТема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	topicDescription = СтрокаТема.Описание;
	
	ПоказатьВводЧисла(
			Новый ОписаниеОповещения("ТемаСоздатьРазделыПриВводеЧисла", ЭтаФорма, Новый Структура("ТемаИмя", СтрокаТема.Имя)),
			topicDescription.partitions.Количество() + 1,
			"Новое количество разделов",
			10,
			0
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаСоздатьРазделыПриВводеЧисла(Число, ДополнительныеПараметры) Экспорт
	
	Если Число = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТемаИмя = ДополнительныеПараметры.ТемаИмя;
	
	Успех = AdminCreatePartitionsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, ТемаИмя, Число);
	Если Успех = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ТемаОбновить(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТемаРазделыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаТемаРазделы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Раздел = -9999;
	Иначе
		Раздел = ТекущиеДанные.Раздел;
	КонецЕсли;
	СтруктураОтбор = Новый ФиксированнаяСтруктура("Раздел", Раздел);
		
	Элементы.ТаблицаТемаРазделыРеплики.ОтборСтрок = СтруктураОтбор;
	
КонецПроцедуры

#КонецОбласти

#Область ТемаДанные

&НаКлиенте
Процедура ТемаДанныеСбросить()
	
	ТаблицаТемаСообщения = "Новые";
	ТаблицаТемаКоличествоНаРаздел = 50;
	ТаблицаТемаДанные.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаДанныеКомандаПолучитьСообщения(Команда)
	
	ТаблицаТемаДанные.Очистить();
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если СтрокаТема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Records = ConsumerGetMessagesНаСервере(Кластер, АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, СтрокаТема.Имя, ТаблицаТемаСообщения, ТаблицаТемаКоличествоНаРаздел);
	Если Records = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого Record Из Records Цикл
		СтрокаТемаДанные = ТаблицаТемаДанные.Добавить();
		СтрокаТемаДанные.Раздел = Record.partition;
		СтрокаТемаДанные.Ключ = Record.key;
		СтрокаТемаДанные.Значение = Record.value;
		СтрокаТемаДанные.МоментВремени = ПредставлениеМоментаВремени(Record.timestamp);
		СтрокаТемаДанные.Смещение = Record.offset;
		Для Каждого Header Из Record.headers Цикл
			СтрокаЗаголовок = СтрокаТемаДанные.Заголовки.Добавить();
			СтрокаЗаголовок.Ключ = Header.key;
			СтрокаЗаголовок.Значение = Header.Value;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаТемаДанные.Сортировать("МоментВремени");
	
КонецПроцедуры

#КонецОбласти

#Область ТемаКонфигурация

&НаКлиенте
Процедура ТемаКонфигурацияПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаТемаКонфигурация.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТемаКонфигурацияОбновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияКомандаОбновить(Команда)
	
	ТемаКонфигурацияОбновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияСбросить()
	
	ТаблицаТемаКонфигурация.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияОбновить()
	
	ТемаКонфигурацияСбросить();
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	Если СтрокаТема = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	topicConfigs = AdminDescribeTopicConfigsНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаТема.Имя);
	Если topicConfigs = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
		
	Для Каждого configEntry Из topicConfigs Цикл
		Если configEntry.sensitive Тогда
			Продолжить;
		КонецЕсли;
		Строка = ТаблицаТемаКонфигурация.Добавить();
		Строка.Имя = configEntry.name;
		Строка.Значение = configEntry.value;
		Строка.ТолькоЧтение = configEntry.readOnly;
		Строка.ПоУмолчанию = configEntry.default;
	КонецЦикла;
	
	ТаблицаТемаКонфигурация.Сортировать("Имя");
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияКомандаИзменить(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаТемаКонфигурация.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьВводСтроки(
			Новый ОписаниеОповещения("ТемаКонфигурацияИзменитьПослеВводаЗначения", ЭтаФорма, Новый Структура("ТекущиеДанные", ТекущиеДанные)),
			ТекущиеДанные.Значение,
			ТекущиеДанные.Имя
	);
		
КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияИзменитьПослеВводаЗначения(НовоеЗначение, ДопПараметры) Экспорт
	
	Если НовоеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	ТекущиеДанные = ДопПараметры.ТекущиеДанные;
	
	Результат = AdminAlterTopicConfigНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаТема.Имя, ТекущиеДанные.Имя, НовоеЗначение);
	Если Результат = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
		
	ТемаКонфигурацияОбновить();

КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияКомандаСбросить(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаТемаКонфигурация.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(
			Новый ОписаниеОповещения("ТемаКонфигурацияСброситьПриОтветеНаВопрос", ЭтаФорма, Новый Структура("ТекущиеДанные", ТекущиеДанные)),
			"Вы действительно хотите сбросить значение параметра?",
			РежимДиалогаВопрос.ДаНет,
			60,
			КодВозвратаДиалога.Нет,
			ТекущиеДанные.Имя,
			КодВозвратаДиалога.Нет
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаКонфигурацияСброситьПриОтветеНаВопрос(РезультатВопроса, ДопПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТема = Элементы.ТаблицаТемы.ТекущиеДанные;
	
	ТекущиеДанные = ДопПараметры.ТекущиеДанные;
	
	Результат = AdminDeleteTopicConfigНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, СтрокаТема.Имя, ТекущиеДанные.Имя);
	Если Результат = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
		
	ТемаКонфигурацияОбновить();
	
КонецПроцедуры

