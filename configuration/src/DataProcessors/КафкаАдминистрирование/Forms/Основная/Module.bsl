КонецПроцедуры

&НаКлиенте
Процедура ГруппаConsumerУдалитьУчастников(ВыделенныеСтроки)
	
	Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаГруппа = Элементы.ТаблицаГруппы.ТекущиеДанные;
	
	Если СтрокаГруппа = Неопределено Или (СтрСравнить(СтрокаГруппа.Тип, "CLASSIC") <> 0 И СтрСравнить(СтрокаГруппа.Тип, "CONSUMER") <> 0) Тогда
		ВызватьИсключение "Неожиданное состояние.";
	КонецЕсли;
	
	Участники = Новый Массив;
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		Строка = ТаблицаГруппаУчастники.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ЗначениеЗаполнено(Строка.ЭкземплярId) Тогда
			Участники.Добавить(Строка.ЭкземплярId);
		КонецЕсли;
	КонецЦикла;
	
	Если Участники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ГруппаId", СтрокаГруппа.Id);
	ПараметрыФормы.Вставить("УдалитьВсех", Ложь);
	ПараметрыФормы.Вставить("Участники", Участники);
	
	ОткрытьФорму(
			"Обработка.КафкаАдминистрирование.Форма.УдалениеУчастниковГруппы",
			ПараметрыФормы,
			ЭтаФорма,
			,
			,
			,
			Новый ОписаниеОповещения("ГруппаConsumerУдалитьУчастниковПриЗакрытииФормы", ЭтаФорма),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаConsumerУдалитьУчастниковПриЗакрытииФормы(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗакрытия.Участники <> Неопределено И РезультатЗакрытия.Участники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	GroupId = РезультатЗакрытия.ГруппаId;
	
	Members = РезультатЗакрытия.Участники;
	
	Если Не ПустаяСтрока(РезультатЗакрытия.Причина) Тогда
		Reason = РезультатЗакрытия.Причина;
	КонецЕсли;
	
	Успех = AdminRemoveMembersFromConsumerGroupНаСервере(АдаптерПараметры, АдаптерКодОтвета, АдаптерОписаниеОшибки, Admin, GroupId, Members, Reason);
	
	Если Успех = Неопределено Тогда
		Сообщить(Строка(АдаптерКодОтвета) + " " + АдаптерОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ГруппаОбновить();
	
КонецПроцедуры

